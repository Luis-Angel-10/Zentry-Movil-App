<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Habilita HTTP en claro (cleartext) solo hacia los hosts de desarrollo
         del backend Zentry (ver res/xml/network_security_config.xml). Se
         fusiona con el <application> de android/app/src/main/AndroidManifest.xml.
         Solo aplica a builds debug: release sigue bloqueando cleartext. -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
