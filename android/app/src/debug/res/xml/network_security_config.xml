<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfico HTTP en claro (cleartext) SOLO hacia los hosts de desarrollo
  del backend Zentry. Desde Android 9 (API 28), el targetSdk actual del
  proyecto bloquea HTTP por defecto (solo HTTPS); el backend local corre en
  HTTP, así que sin esto ninguna petición llega ni al emulador.

  Solo existe en la variante "debug" (android/app/src/debug/), por lo que NO
  afecta a builds de release, que siguen sin poder usar cleartext hacia
  ningún host.

  El default de la app (ApiConfig.defaultBaseUrl) es el backend desplegado
  por HTTPS y NO depende de nada de este archivo. Estos hosts solo se usan
  cuando se sobrescribe la URL con ZENTRY_API_BASE_URL (o adb reverse) para
  apuntar a un backend local en HTTP.

  Hosts habilitados:
    - 10.0.2.2      : Android Emulator (loopback del host)
    - 192.168.1.71  : laptop del backend en LAN, usada para pruebas en
                       dispositivo físico (Huawei MatePad 11.5S) vía el
                       flag ZENTRY_API_BASE_URL definido con dart define,
                       apuntando a http dos puntos barra barra 192.168.1.71:8080
    - localhost / 127.0.0.1 : con adb reverse tcp 8080 tcp 8080

  Si la IP de la laptop cambia, añade aquí el nuevo valor (o pásalo solo por
  el flag ZENTRY_API_BASE_URL y añade también su dominio aquí).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.71</domain>
        <domain includeSubdomains="false">192.168.0.105</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
