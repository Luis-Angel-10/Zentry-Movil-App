# Copia este archivo como `.env` en la raíz del proyecto y completa los valores.
# NO subas el `.env` real al repositorio (está en .gitignore).
# Este archivo solo contiene PLACEHOLDERS, nunca credenciales reales.

# --- BASE DE DATOS (PostgreSQL / NeonDB) ---
# En desarrollo local puedes omitir estas variables: el perfil "dev" usa por
# defecto jdbc:postgresql://localhost:5432/zentry_db con postgres/postgres.
DB_URL=jdbc:postgresql://localhost:5432/zentry_db
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Ejemplo NeonDB (reemplaza host, usuario y password por los tuyos):
# DB_URL=jdbc:postgresql://<neon-host>/neondb?sslmode=require&channelBinding=require
# DB_USERNAME=<neon-user>
# DB_PASSWORD=<neon-password>

# --- JWT ---
# Debe ser una cadena Base64 VÁLIDA y larga (>= 256 bits) porque JwtService hace
# Decoders.BASE64.decode(...) y firma con HS256. Generar, por ejemplo, con:
#   openssl rand -base64 48
# Obligatorio en prod: la aplicación no arranca sin JWT_SECRET.
JWT_SECRET=<genera_un_secreto_base64_de_al_menos_256_bits>

# Expiración del token en milisegundos (opcional, por defecto 86400000 = 1 día).
JWT_EXPIRATION_MS=86400000

# --- CORS ---
# Los orígenes permitidos (localhost de desarrollo, dev tunnels, Tailscale, LAN)
# están definidos directamente en SecurityConfig#corsConfigurationSource como
# allowedOriginPatterns, no via variable de entorno. No se requiere configurar
# nada aquí para CORS.

# --- MAIL (SMTP) — envío real del OTP de verificación de correo ---
# Placeholders únicamente. Sustituye por los datos reales de tu proveedor SMTP
# (Gmail con contraseña de aplicación, SendGrid, Brevo, Resend, Mailgun, tu propio
# servidor, etc.) — nunca subas credenciales reales a este archivo. Con Gmail,
# MAIL_PASSWORD debe ser una "contraseña de aplicación" (no la contraseña normal
# de la cuenta), generada en https://myaccount.google.com/apppasswords (requiere
# 2FA activado).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=example@example.com
MAIL_PASSWORD=change_me
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=false
MAIL_TEST_CONNECTION=false
